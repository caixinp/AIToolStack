[Unit]
Description=AIToolStack Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=chakcy
Group=chakcy
WorkingDirectory=/home/chakcy/AIToolStack
Environment="TZ=Asia/Shanghai"
ExecStartPre=/home/chakcy/AIToolStack/scripts/init-ne301.sh
ExecStart=/home/chakcy/.local/bin/uv run python -m gunicorn backend.main:app -k uvicorn.workers.UvicornWorker -w 4 -b 0.0.0.0:8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
